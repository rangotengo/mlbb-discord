<div class="config-page page-narrow">
	<div class="page-header">
		<div><h2 class="page-title">Settings</h2><p class="page-subtitle">Environment values for this install. Discord token stays hidden.</p></div>
	</div>

	<% if (locals.success) { %>
		<div class="alert alert-success">Configuration saved successfully.</div>
	<% } %>
	
	<% if (locals.error) { %>
		<div class="alert alert-danger"><%= error %></div>
	<% } %>

	<% if (locals.serverRestart) { %>
		<div class="alert alert-warning">
			<strong>Server restart required:</strong> Changes to <code>SQLITE_DB</code> require a full application restart to take effect. Please restart the backend process entirely.
		</div>
	<% } else if (locals.botRestart) { %>
		<div class="alert alert-warning">
			<strong>Bot restart required:</strong> Changes to Prefix or Role require the bot client to restart to reflect these properly. Please restart the application.
		</div>
	<% } %>

	<div class="card">
		<div class="card-header">
			<h3 class="card-title">Environment Variables</h3>
            <p class="text-secondary">
                Manage your environment variables below. Note that DISCORD_TOKEN is hidden for security.
            </p>
		</div>
		<form method="POST" action="/config" class="form">
			<div class="form-grid">
				<% Object.entries(configData).forEach(([key, value]) => { %>
					<div class="form-group">
						<label class="form-label" for="<%= key %>"><%= key %></label>
						<input type="text" id="<%= key %>" name="<%= key %>" class="form-input" value="<%= value %>">
					</div>
				<% }); %>
			</div>
			
			<div class="form-actions">
				<button type="submit" class="btn btn-primary">Save Configuration</button>
			</div>
		</form>
	</div>
</div>



<script>
	// Remove query parameters from the URL so that "Restart required" or "Success" 
	// alerts don't persist if the user refreshes the page manually after a restart.
	if (window.history.replaceState && window.location.search) {
		const newUrl = window.location.protocol + "//" + window.location.host + window.location.pathname;
		window.history.replaceState({ path: newUrl }, "", newUrl);
	}
</script>

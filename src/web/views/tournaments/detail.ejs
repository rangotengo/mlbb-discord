<%- contentFor('script') %>
<script>
const tournamentId = <%- JSON.stringify(tournamentId).replace(/</g, '\u003c') %>;
const tournamentPathId = encodeURIComponent(tournamentId);

document.addEventListener('DOMContentLoaded', () => {
	const tzSelect = document.getElementById('schedule-timezone');
	if (tzSelect && Intl.supportedValuesOf) {
		const timezones = Intl.supportedValuesOf('timeZone');
		const localTz = Intl.DateTimeFormat().resolvedOptions().timeZone;
		
		timezones.forEach(tz => {
			const option = document.createElement('option');
			option.value = tz;
			option.textContent = tz.replace(/_/g, ' ');
			if (tz === localTz) {
				option.selected = true;
			}
			tzSelect.appendChild(option);
		});
	}

	// Handle tab persistence
	const hash = window.location.hash.replace('#', '');
	if (hash === 'participants' || hash === 'schedules') {
		switchTab(hash);
	}
});

let announcementSchedules = [];
function renderAnnouncementRounds(schedules) {
	announcementSchedules = schedules;
	const select = document.getElementById('announcement-round');
	const previous = select.value;
	select.replaceChildren(new Option('Choose a round', ''));
	const rounds = [...new Set(schedules.map(s => s.round).filter(r => Number.isInteger(r) && r !== 0))].sort((a, b) => a - b);
	for (const round of rounds) select.add(new Option(`Round ${round}`, String(round)));
	select.value = previous;
	updateAnnouncementCount();
}
function updateAnnouncementCount() {
	const selected = document.getElementById('announcement-round').value;
	const count = new Set(announcementSchedules.filter(s => s.round === Number(selected)).map(s => s.threadId).filter(Boolean)).size;
	document.getElementById('announcement-targets').textContent = selected ? `Round ${selected}: ${count} match thread(s)` : 'Choose a round to see the thread count.';
	document.getElementById('announcement-send').disabled = !selected || !count;
}
async function sendRoundAnnouncement(event) {
	event.preventDefault();
	const button = document.getElementById('announcement-send');
	if (button.disabled) return;
	const round = document.getElementById('announcement-round').value;
	const message = document.getElementById('announcement-message').value.trim();
	if (!message) return;
	button.disabled = true;
	const result = document.getElementById('announcement-result');
	result.textContent = 'Sending...';
	try {
		const response = await Dot.API.post(`/api/tournaments/${tournamentPathId}/rounds/${encodeURIComponent(round)}/announcement`, { message });
		const { sent, failed, total } = response.data;
		result.textContent = `Round ${round}: sent to ${sent.length} of ${total} threads.` + (failed.length ? `\nFailed thread IDs: ${failed.join(', ')}. Check these threads before retrying; resending will also repeat successful deliveries.` : '');
		if (!failed.length) document.getElementById('announcement-message').value = '';
	} catch (error) {
		result.textContent = error.message;
	} finally {
		updateAnnouncementCount();
	}
}

async function loadTournamentData() {
	try {
		const [tRes, pRes, sRes] = await Promise.all([
			Dot.API.get(`/api/tournaments/${tournamentPathId}`),
			Dot.API.get(`/api/tournaments/${tournamentPathId}/participants`),
			Dot.API.get(`/api/tournaments/${tournamentPathId}/schedules`)
		]);

		renderParticipants(pRes.data || []);
		renderInfo(tRes.data);
		renderSchedules(sRes.data || []);
		renderAnnouncementRounds(sRes.data || []);
	} catch (error) {
		console.error("Failed to load tournament data:", error);
		Dot.Toast.error("Failed to load tournament data");
	}
}

function renderInfo(t) {
	document.getElementById('t-name').textContent = t.name || tournamentId;
	
	// Status
	const statusEl = document.getElementById('t-status-badge');
	const status = t.status || 'unknown';
	statusEl.textContent = status;
	statusEl.className = `badge badge-${getStatusBadgeClass(status)}`;

	document.getElementById('t-format').textContent = t.format || 'Unknown Format';
	renderPreCheckin(t);

	// Info Cards
	document.getElementById('t-server').textContent = t.server || '—';

	const cap = t.participantLimit ? `${t.enrolledCount || 0} / ${t.participantLimit}` : `${t.enrolledCount || 0} / ∞`;
	document.getElementById('t-capacity').textContent = cap;

	// Verification Stats
	document.getElementById('t-verified-count').textContent = t.verifiedCount || 0;
	document.getElementById('t-unverified-count').textContent = t.unverifiedCount || 0;

	// Tab Counts
	document.getElementById('t-p-count').textContent = t.enrolledCount || 0;
	document.getElementById('t-s-count').textContent = t.scheduledCount || 0;

	const channelId = t.checkInChannelId || '1566425054168744057';
	document.getElementById('checkin-channel-value').textContent = channelId;
	if (document.getElementById('checkin-edit-form').hidden) document.getElementById('checkin-channel').value = channelId;
	const checkInBox = document.getElementById('checkin-enabled');
	const checkInLabel = document.getElementById('checkin-label');
	if (checkInBox) {
		checkInBox.checked = !t.checkInDisabled;
		checkInBox.dataset.ready = '1';
		if (checkInLabel) checkInLabel.textContent = t.checkInDisabled ? 'Check-in off' : 'Check-in on';
	}

}

let currentTournament = null;

function renderPreCheckin(t) {
	currentTournament = t;
	document.getElementById('btn-sync').hidden = !t.hasBracket;
	document.getElementById('btn-start-round').hidden = !t.hasBracket;
	renderVerifiedTeams();
}

function verifiedTeamNames() {
	const rows = [...document.querySelectorAll('#participants-body tr')];
	return [...new Set(rows.filter(row => row.querySelector('.badge-success')).map(row => {
		const name = row.querySelector('strong');
		return name ? name.textContent.trim() : '';
	}).filter(Boolean))].sort((a, b) => a.localeCompare(b));
}

function renderVerifiedTeams() {
	const teams = verifiedTeamNames();
	const panel = document.getElementById('precheckin-panel');
	const waitingForBracket = currentTournament && !currentTournament.hasBracket && currentTournament.phase !== 'linked';
	panel.hidden = teams.length === 0 && !waitingForBracket;
	document.getElementById('precheckin-summary').textContent = teams.length
		? `${teams.length} team(s) verified by Discord identity.`
		: 'No Discord-verified teams yet. You can still link a bracket that already exists on Challonge.';
	const exportLink = document.getElementById('precheckin-export');
	exportLink.hidden = teams.length === 0;
	exportLink.href = `/api/tournaments/${tournamentPathId}/precheckin/export`;
	document.getElementById('precheckin-copy').hidden = teams.length === 0;
	const linkForm = document.getElementById('precheckin-link-form');
	linkForm.hidden = !waitingForBracket;
	const list = document.getElementById('precheckin-teams');
	list.replaceChildren();
	for (const team of teams) {
		const item = document.createElement('li');
		item.textContent = team;
		list.appendChild(item);
	}
}

function enrolledTeamNames() {
	return [...new Set([...document.querySelectorAll('#participants-body tr strong')].map(node => node.textContent.trim()).filter(Boolean))]
		.sort((a, b) => a.localeCompare(b));
}

async function copyCheckedInTeams() {
	const teams = verifiedTeamNames();
	if (!teams.length) return;
	try {
		await navigator.clipboard.writeText(teams.join('\n'));
		Dot.Toast.success(`${teams.length} team name(s) copied`);
	} catch (error) {
		Dot.Toast.error('Could not copy team names');
	}
}

async function linkExistingBracket(event) {
	event.preventDefault();
	const button = document.getElementById('precheckin-link');
	const url = document.getElementById('precheckin-url').value.trim();
	button.disabled = true;
	try {
		const response = await Dot.API.post(`/api/tournaments/${tournamentPathId}/precheckin/link`, { url });
		Dot.Toast.success(response.already ? 'Bracket already linked' : 'Challonge bracket linked');
		document.getElementById('precheckin-url').value = '';
		await loadTournamentData();
	} catch (error) {
		Dot.Toast.error(error.message || 'Failed to link Challonge bracket');
	} finally {
		button.disabled = false;
	}
}

async function openPreCheckin() {
	const button = document.getElementById('precheckin-open');
	button.disabled = true;
	try {
		await Dot.API.post(`/api/tournaments/${tournamentPathId}/precheckin/open`);
		Dot.Toast.success('Team check-in is open');
		await loadTournamentData();
	} catch (error) {
		Dot.Toast.error(error.message || 'Failed to open check-in');
	} finally {
		button.disabled = false;
	}
}

async function checkInAllDashboardTeams() {
	const button = document.getElementById('precheckin-all');
	button.disabled = true;
	try {
		await Dot.API.post(`/api/tournaments/${tournamentPathId}/precheckin/teams/all`);
		Dot.Toast.success('All enrolled teams checked in');
		await loadTournamentData();
	} catch (error) {
		Dot.Toast.error(error.message || 'Failed to check in teams');
	} finally {
		button.disabled = false;
	}
}

async function checkInDashboardTeam(team) {
	try {
		await Dot.API.post(`/api/tournaments/${tournamentPathId}/precheckin/teams`, { team });
		Dot.Toast.success(`${team} checked in`);
		await loadTournamentData();
	} catch (error) {
		Dot.Toast.error(error.message || 'Failed to check in team');
	}
}

async function closePreCheckin() {
	const button = document.getElementById('precheckin-close');
	button.disabled = true;
	try {
		const response = await Dot.API.post(`/api/tournaments/${tournamentPathId}/precheckin/close`);
		Dot.Toast.success(response.already ? 'Bracket already exists' : `Bracket created: ${response.url}`);
		await loadTournamentData();
	} catch (error) {
		Dot.Toast.error(error.message || 'Failed to create bracket');
		button.disabled = false;
	}
}

function getStatusBadgeClass(status) {
	switch (status) {
		case 'preparing': return 'warning';
		case 'in progress': return 'info';
		case 'complete': return 'success';
		default: return 'secondary';
	}
}

function renderParticipants(participants) {
	const tbody = document.getElementById('participants-body');
	
	if (!participants.length) {
		tbody.innerHTML = `<tr><td colspan="5" class="empty-state"><div class="empty-state-text">No participants enrolled</div></td></tr>`;
		return;
	}

	tbody.innerHTML = participants.map(p => `
		<tr>
			<td><strong>${escapeHtml(p.team)}</strong></td>
			<td>${escapeHtml(p.name)}</td>
			<td>${p.discordUsername ? escapeHtml(p.discordUsername) : '<span style="color:var(--text-secondary)">—</span>'}</td>
			<td>${p.challongeId || '<span style="color:var(--text-secondary)">—</span>'}</td>
			<td><span class="badge badge-${p.verified ? 'success' : 'warning'}">${p.verified ? 'Verified' : 'Unverified'}</span></td>
		</tr>
	`).join('');
	renderVerifiedTeams();
}

function renderSchedules(schedules) {
	const tbody = document.getElementById('schedules-body');
	
	if (!schedules.length) {
		tbody.innerHTML = `<tr><td colspan="7" class="empty-state"><div class="empty-state-text">No matches scheduled</div></td></tr>`;
		return;
	}

	tbody.innerHTML = schedules.map(s => {
		const dateObj = new Date(s.scheduledTime);
		let formattedDate = s.scheduledTime;
		
		if (!isNaN(dateObj.getTime())) {
			if (dateObj.getFullYear() > 2090) {
				formattedDate = '<span style="color:var(--text-secondary)">Not set</span>';
			} else {
				formattedDate = dateObj.toLocaleString(undefined, { 
					weekday: 'short', month: 'short', day: 'numeric', 
					hour: '2-digit', minute: '2-digit' 
				});
			}
		}
		
		return `
		<tr>
			<td><strong>#${s.matchId}</strong></td>
			<td>Round ${s.round || '?'}</td>
			<td>${formattedDate}</td>
			<td>${s.threadId || '<span style="color:var(--text-secondary)">—</span>'}</td>
			<td><span class="${s.notified ? 'text-success' : 'text-secondary'}">${s.notified ? 'Yes' : 'No'}</span></td>
		</tr>
		`;
	}).join('');
}

function switchTab(tabId) {
	document.querySelectorAll('.tab-btn').forEach(btn => btn.classList.remove('active'));
	document.querySelectorAll('.tab-pane').forEach(pane => pane.classList.remove('active'));
	
	const btn = document.querySelector(`.tab-btn[data-tab="${tabId}"]`);
	const pane = document.getElementById(`pane-${tabId}`);
	
	if (btn && pane) {
		btn.classList.add('active');
		pane.classList.add('active');
		// Update URL hash without jumping
		history.replaceState(null, null, `#${tabId}`);
	}
}

async function syncTournament() {
	try {
		const btn = document.getElementById('btn-sync');
		btn.disabled = true;
		btn.textContent = 'Syncing...';

		const response = await Dot.API.post(`/api/tournaments/${tournamentPathId}/sync`);
		const data = response.data;

		let message = 'Tournament synced successfully!';
		if (data.matchedPlayers !== undefined) {
			message += ` Matched ${data.matchedPlayers} participants.`;
		}
		if (data.addedSchedules !== undefined) {
			message += ` Added ${data.addedSchedules} new schedules.`;
		}
		if (data.skippedSchedules !== undefined && data.skippedSchedules > 0) {
			message += ` Skipped ${data.skippedSchedules} existing schedules.`;
		}

		Dot.Toast.success(message);

		// Reload data
		await loadTournamentData();
	} catch (error) {
		console.error('Failed to sync tournament:', error);
		Dot.Toast.error('Failed to sync tournament');
	} finally {
		const btn = document.getElementById('btn-sync');
		btn.disabled = false;
		btn.textContent = 'Sync from Challonge';
	}
}


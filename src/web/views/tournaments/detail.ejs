	}
}


function escapeHtml(text) {
	if (!text) return '';
	const div = document.createElement('div');
	div.textContent = text;
	return div.innerHTML;
}



// ============================================
// CSV Import Functions
// ============================================

let currentCSVImportType = null;
let currentCSVData = null;
let parsedCSVRows = [];

function openCSVImportModal(type) {
	currentCSVImportType = type;
	currentCSVData = null;
	parsedCSVRows = [];

	// Reset modal state
	clearCSVFile();
	document.getElementById('csv-preview-section').style.display = 'none';
	document.getElementById('csv-options-section').style.display = 'none';
	document.getElementById('csv-import-btn').disabled = true;

	// Set title
	const title = type === 'participants' ? 'Import Participants from CSV' : 'Import Schedules from CSV';
	document.getElementById('csv-modal-title').textContent = title;

	// Show/hide Challengermode option
	document.getElementById('csv-options-section').style.display = type === 'participants' ? 'block' : 'none';

	// Show modal
	document.getElementById('csv-import-modal').style.display = 'flex';

	// Setup drag and drop
	setupDropzone();
}

function closeCSVImportModal() {
	document.getElementById('csv-import-modal').style.display = 'none';
	currentCSVImportType = null;
	currentCSVData = null;
	parsedCSVRows = [];
}

function setupDropzone() {
	const dropzone = document.getElementById('csv-dropzone');

	dropzone.onclick = () => document.getElementById('csv-file-input').click();

	dropzone.ondragover = (e) => {
		e.preventDefault();
		dropzone.classList.add('drag-over');
	};

	dropzone.ondragleave = () => {
		dropzone.classList.remove('drag-over');
	};

	dropzone.ondrop = (e) => {
		e.preventDefault();
		dropzone.classList.remove('drag-over');

		const files = e.dataTransfer.files;
		if (files.length > 0) {
			processCSVFile(files[0]);
		}
	};
}

function handleCSVFileSelect(event) {
	const file = event.target.files[0];
	if (file) {
		processCSVFile(file);
	}
}

function processCSVFile(file) {
	if (!file.name.endsWith('.csv')) {
		Dot.Toast.error('Please select a CSV file');
		return;
	}

	const reader = new FileReader();
	reader.onload = (e) => {
		currentCSVData = e.target.result;
		displayFileInfo(file);
		parseAndPreviewCSV();
	};
	reader.readAsText(file);
}

function displayFileInfo(file) {
	document.getElementById('csv-dropzone').style.display = 'none';
	document.getElementById('csv-file-info').style.display = 'block';
	document.getElementById('csv-file-name').textContent = file.name;
	document.getElementById('csv-file-size').textContent = formatFileSize(file.size);
}

function clearCSVFile() {
	currentCSVData = null;
	parsedCSVRows = [];
	document.getElementById('csv-file-input').value = '';
	document.getElementById('csv-dropzone').style.display = 'block';
	document.getElementById('csv-file-info').style.display = 'none';
	document.getElementById('csv-preview-section').style.display = 'none';
	document.getElementById('csv-import-btn').disabled = true;
}

function formatFileSize(bytes) {
	if (bytes < 1024) return bytes + ' B';
	if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + ' KB';
	return (bytes / (1024 * 1024)).toFixed(1) + ' MB';
}

let lastPreviewRows = [];
let lastRejectedRows = [];

async function parseAndPreviewCSV() {
	if (!currentCSVData) return;

	const btn = document.getElementById('csv-import-btn');
	const badgesEl = document.getElementById('csv-diff-badges');
	const rejectionsBar = document.getElementById('csv-rejection-bar');

	if (badgesEl) badgesEl.innerHTML = '';
	if (rejectionsBar) rejectionsBar.style.display = 'none';
	lastRejectedRows = [];
	lastPreviewRows = [];

	// Try the server preview endpoint (Contract agreed and landed)
	try {
		const res = await Dot.API.post(`/api/tournaments/${tournamentId}/${currentCSVImportType}/preview`, {
			csv: currentCSVData
		});

		const preview = res.data || {};
		lastPreviewRows = preview.rows || [];
		lastRejectedRows = lastPreviewRows.filter(r => r.status === 'rejected');

		if (badgesEl) {
			badgesEl.innerHTML = `
				<span class="row-badge row-badge-added">${preview.added || 0} added</span>
				<span class="row-badge row-badge-changed">${preview.changed || 0} changed</span>
				<span class="row-badge row-badge-unchanged">${preview.unchanged || 0} unchanged</span>
				<span class="row-badge row-badge-rejected">${preview.rejected || 0} rejected</span>
			`;
		}

		if (preview.rejected > 0) {
			if (rejectionsBar) rejectionsBar.style.display = 'block';
			showPreviewWarning(`${preview.rejected} row(s) contain validation errors and will be rejected. You can download the correction file below.`);
		} else {
			hidePreviewWarning();
		}

		renderServerPreviewRows(lastPreviewRows);
		document.getElementById('csv-preview-count').textContent = lastPreviewRows.length;
		document.getElementById('csv-preview-section').style.display = 'block';
		document.getElementById('csv-options-section').style.display = 'block';
		btn.disabled = false;
		return;
	} catch (err) {
		console.warn('Server preview endpoint unavailable or failed, falling back to local preview:', err);
	}

	// Local fallback:
	const lines = currentCSVData.trim().split('\n').map(l => l.trim()).filter(l => l.length > 0);
	if (lines.length < 2) {
		Dot.Toast.error('CSV must have at least a header and one data row');
		return;
	}

	const headers = parseCSVRow(lines[0]);
	parsedCSVRows = [];
	for (let i = 1; i < lines.length; i++) {
		const columns = parseCSVRow(lines[i]);
		parsedCSVRows.push(columns);
	}

	// Validate headers
	const expectedCols = currentCSVImportType === 'participants'
		? ['email', 'name', 'team']
		: ['match_id', 'scheduled_time'];

	const headersLower = headers.map(h => h.toLowerCase());
	const missingCols = expectedCols.filter(col => !headersLower.some(h => h.includes(col)));

	if (missingCols.length > 0) {
		showPreviewWarning(`Missing required columns: ${missingCols.join(', ')}`);
	} else {
		hidePreviewWarning();
	}

	renderCSVPreview(headers);
	document.getElementById('csv-options-section').style.display = 'block';
	btn.disabled = false;
}

function renderServerPreviewRows(rows) {
	const thead = document.getElementById('csv-preview-thead');
	const tbody = document.getElementById('csv-preview-tbody');

	if (!rows.length) {
		thead.innerHTML = '';
		tbody.innerHTML = '<tr><td colspan="5" class="empty-state">No rows to preview</td></tr>';
		return;
	}

	const firstRowValues = rows[0].values || {};
	const valKeys = Object.keys(firstRowValues);
	const headers = ['Row', 'Status', ...valKeys, 'Notes'];

	thead.innerHTML = '<tr>' + headers.map(h => `<th>${escapeHtml(h)}</th>`).join('') + '</tr>';

	tbody.innerHTML = rows.slice(0, 15).map(r => {
		const statusBadge = `<span class="row-badge row-badge-${r.status}">${escapeHtml(r.status)}</span>`;
		const cells = valKeys.map(k => `<td>${escapeHtml(String((r.values && r.values[k]) || ''))}</td>`).join('');
		const reasonCell = `<td>${escapeHtml(r.reason || '—')}</td>`;
		return `<tr><td>${r.row}</td><td>${statusBadge}</td>${cells}${reasonCell}</tr>`;
	}).join('');
}

function downloadRejectedRowsCSV() {
	if (!lastRejectedRows.length) {
		Dot.Toast.info('No rejected rows to download.');
		return;
	}

	const firstVals = lastRejectedRows[0].values || {};
	const headers = ['row', 'rejection_reason', ...Object.keys(firstVals)];
	const rows = lastRejectedRows.map(r => ({
		row: r.row,
		rejection_reason: r.reason || 'Validation error',
		...(r.values || {})
	}));

	const csvString = window.DotHelpers
		? DotHelpers.buildCsv(rows, headers)
		: [headers.join(','), ...rows.map(r => Object.values(r).join(','))].join('\n');

	const blob = new Blob([csvString], { type: 'text/csv;charset=utf-8;' });
	const url = URL.createObjectURL(blob);
	const a = document.createElement('a');
	a.href = url;
	a.download = `rejected-${currentCSVImportType}-corrections.csv`;
	document.body.appendChild(a);
	a.click();
	document.body.removeChild(a);
	URL.revokeObjectURL(url);
	Dot.Toast.success('Downloaded rejected rows for correction.');
}

function parseCSVRow(row) {
	const result = [];
	let current = '';
	let inQuotes = false;

	for (let i = 0; i < row.length; i++) {
		const char = row[i];

		if (char === '"') {
			inQuotes = !inQuotes;
		} else if (char === ',' && !inQuotes) {
			result.push(current.trim());
			current = '';
		} else {
			current += char;
		}
	}
	result.push(current.trim());

	return result;
}

function renderCSVPreview(headers) {
	const thead = document.getElementById('csv-preview-thead');
	const tbody = document.getElementById('csv-preview-tbody');

	// Render header
	thead.innerHTML = '<tr>' + headers.map(h => `<th>${escapeHtml(h)}</th>`).join('') + '</tr>';

	// Render rows (max 10 for preview)
	const previewRows = parsedCSVRows.slice(0, 10);
	tbody.innerHTML = previewRows.map(row => {
		return '<tr>' + row.map(cell => `<td>${escapeHtml(cell)}</td>`).join('') + '</tr>';
	}).join('');

	// Update count
	document.getElementById('csv-preview-count').textContent = parsedCSVRows.length;

	// Show preview section
	document.getElementById('csv-preview-section').style.display = 'block';
}

function showPreviewWarning(message) {
	const warningsEl = document.getElementById('csv-preview-warnings');
	warningsEl.textContent = '⚠️ ' + message;
	warningsEl.style.display = 'block';
}

function hidePreviewWarning() {
	document.getElementById('csv-preview-warnings').style.display = 'none';
}

async function confirmCSVImport() {
	if (!currentCSVData || !currentCSVImportType) return;

	const btn = document.getElementById('csv-import-btn');
	const btnText = document.getElementById('csv-import-btn-text');
	btn.disabled = true;
	btnText.textContent = 'Importing...';

	const modeInput = document.querySelector('input[name=\"csv-mode\"]:checked');
	const mode = modeInput ? modeInput.value : 'partial';

	try {
		const endpoint = `/api/tournaments/${tournamentId}/${currentCSVImportType}/import`;
		const body = { csv: currentCSVData, mode };

		if (currentCSVImportType === 'participants') {
			body.registerToChallonge = document.getElementById('csv-register-challonge').checked;
		}

		const response = await Dot.API.post(endpoint, body);
		const data = response.data || {};
		let message = `Import complete!`;
		if (data.added !== undefined) message += ` Added: ${data.added}.`;
		if (data.updated !== undefined) message += ` Updated: ${data.updated}.`;
		if (data.unchanged !== undefined) message += ` Unchanged: ${data.unchanged}.`;
		if (data.errors && data.errors.length) message += ` Errors: ${data.totalErrors || data.errors.length}.`;

		Dot.Toast.success(message);
		await loadTournamentData();
		closeCSVImportModal();

	} catch (error) {
		console.error('CSV import failed:', error);
		const errorPayload = error.payload || {};
		const errorMsg = errorPayload.error || error.message || 'Import failed. Please check your CSV format.';

		// If all-or-nothing failed with rejected row data:
		if (errorPayload.data && Array.isArray(errorPayload.data.rows)) {
			lastPreviewRows = errorPayload.data.rows;
			lastRejectedRows = lastPreviewRows.filter(r => r.status === 'rejected');
			if (lastRejectedRows.length > 0) {
				const rejectionsBar = document.getElementById('csv-rejection-bar');
				if (rejectionsBar) rejectionsBar.style.display = 'block';
				showPreviewWarning(`All-or-Nothing check failed: ${errorPayload.data.rejected || lastRejectedRows.length} row(s) rejected. Nothing was saved. Download the rejected rows below to correct them.`);
				renderServerPreviewRows(lastPreviewRows);
			}
		}

		Dot.Toast.error(errorMsg);
	} finally {
		btn.disabled = false;
		btnText.textContent = 'Import';
	}
}


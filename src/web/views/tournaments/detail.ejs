<%- contentFor('script') %>
<script>
const tournamentId = "<%= tournamentId %>";
let currentTournamentData = null;
let currentParticipants = [];
let currentSchedules = [];
let currentMatches = [];
let currentViewTz = (typeof Intl !== 'undefined' && Intl.DateTimeFormat) ? Intl.DateTimeFormat().resolvedOptions().timeZone : 'UTC';
let isChecklistCollapsed = false;

document.addEventListener('DOMContentLoaded', () => {
	// Initialize timezones for modal and view select
	if (typeof Intl !== 'undefined' && Intl.supportedValuesOf) {
		const timezones = Intl.supportedValuesOf('timeZone');
		const modalTzSelect = document.getElementById('schedule-timezone');
		const viewTzSelect = document.getElementById('tz-view-select');

		if (viewTzSelect) viewTzSelect.innerHTML = '';
		if (modalTzSelect) modalTzSelect.innerHTML = '<option value="">Select a timezone...</option>';

		timezones.forEach(tz => {
			const label = tz.replace(/_/g, ' ');
			if (modalTzSelect) {
				const opt1 = document.createElement('option');
				opt1.value = tz;
				opt1.textContent = label;
				if (tz === currentViewTz) opt1.selected = true;
				modalTzSelect.appendChild(opt1);
			}
			if (viewTzSelect) {
				const opt2 = document.createElement('option');
				opt2.value = tz;
				opt2.textContent = label;
				if (tz === currentViewTz) opt2.selected = true;
				viewTzSelect.appendChild(opt2);
			}
		});
	}

	// Handle tab persistence
	const hash = window.location.hash.replace('#', '');
	if (hash === 'participants' || hash === 'schedules') {
		switchTab(hash);
	}
});

function onTimezoneChange() {
	const sel = document.getElementById('tz-view-select');
	if (sel) {
		currentViewTz = sel.value || 'UTC';
		renderSchedules(currentSchedules);
	}
}

async function loadTournamentData() {
	try {
		const [tRes, pRes, sRes] = await Promise.all([
			Dot.API.get(`/api/tournaments/${tournamentId}`),
			Dot.API.get(`/api/tournaments/${tournamentId}/participants`),
			Dot.API.get(`/api/tournaments/${tournamentId}/schedules`)
		]);

		currentTournamentData = tRes.data || {};
		currentParticipants = pRes.data || [];
		currentSchedules = sRes.data || [];

		renderInfo(currentTournamentData);
		renderChecklist(currentTournamentData, currentParticipants, currentSchedules);
		renderParticipants(currentParticipants);
		renderSchedules(currentSchedules);
	} catch (error) {
		console.error("Failed to load tournament data:", error);
		Dot.Toast.error("Failed to load tournament data: " + error.message);
	}
}

function renderInfo(t) {
	document.getElementById('t-name').textContent = t.name || tournamentId;

	// Status
	const statusEl = document.getElementById('t-status-badge');
	const status = t.status || 'unknown';
	statusEl.textContent = status;
	statusEl.className = `badge badge-${getStatusBadgeClass(status)}`;

	document.getElementById('t-format').textContent = t.format || 'Unknown Format';

	// Sync freshness badge (Guide 15)
	const syncFreshnessEl = document.getElementById('t-sync-freshness');
	if (syncFreshnessEl) {
		if (t.lastSyncSuccess) {
			const successMs = new Date(t.lastSyncSuccess).getTime();
			const attemptMs = t.lastSyncAttempt ? new Date(t.lastSyncAttempt).getTime() : 0;
			if (attemptMs - successMs > 60000) {
				syncFreshnessEl.className = 'sync-badge sync-badge-stale';
				syncFreshnessEl.textContent = `Sync: Stale (failed ${Dot.Utils.formatRelativeTime(t.lastSyncAttempt)})`;
				syncFreshnessEl.title = `Last attempt: ${t.lastSyncAttempt}`;
			} else {
				syncFreshnessEl.className = 'sync-badge sync-badge-fresh';
				syncFreshnessEl.textContent = `Synced ${Dot.Utils.formatRelativeTime(t.lastSyncSuccess)}`;
				syncFreshnessEl.title = `Synced successfully: ${t.lastSyncSuccess}`;
			}
		} else if (t.lastSyncAttempt) {
			syncFreshnessEl.className = 'sync-badge sync-badge-stale';
			syncFreshnessEl.textContent = `Sync failed (${Dot.Utils.formatRelativeTime(t.lastSyncAttempt)})`;
		} else {
			syncFreshnessEl.className = 'sync-badge sync-badge-never';
			syncFreshnessEl.textContent = 'Sync: Never synced';
		}
	}

	// Info Cards
	document.getElementById('t-server').textContent = t.server || '—';

	const cap = t.participantLimit ? `${t.enrolledCount || 0} / ${t.participantLimit}` : `${t.enrolledCount || 0} / ∞`;
	document.getElementById('t-capacity').textContent = cap;

	// Verification Stats
	document.getElementById('t-verified-count').textContent = t.verifiedCount || 0;
	document.getElementById('t-unverified-count').textContent = t.unverifiedCount || 0;

	// Tab Counts
	document.getElementById('t-p-count').textContent = t.enrolledCount || 0;
	document.getElementById('t-s-count').textContent = t.scheduledCount || 0;

	// Check-in toggle button state
	const checkInBtn = document.getElementById('btn-toggle-checkin');
	if (checkInBtn) {
		if (t.checkInDisabled) {
			checkInBtn.className = 'btn btn-success';
			checkInBtn.innerHTML = `<span class="btn-icon"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg></span> 🔓 Enable Check-in`;
		} else {
			checkInBtn.className = 'btn btn-warning';
			checkInBtn.innerHTML = `<span class="btn-icon"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg></span> 🔒 Disable Check-in`;
		}
	}
}

// Setup Checklist Evaluator (Guide 11)
function renderChecklist(t, participants, schedules) {
	const container = document.getElementById('checklist-items');
	const badge = document.getElementById('checklist-progress-badge');
	if (!container || !window.DotHelpers) return;

	let timesSet = 0;
	schedules.forEach(s => {
		if (!s.scheduledTime) return;
		const d = new Date(s.scheduledTime);
		if (!isNaN(d.getTime()) && d.getFullYear() <= 2090) {
			timesSet++;
		}
	});

	// Unmatched teams: participants without a Challengermode/Challonge ID
	const unmatchedTeams = participants.filter(p => !p.challongeId).length;

	const items = DotHelpers.evaluateChecklist({
		participantCount: participants.length,
		unmatchedTeams: unmatchedTeams,
		checkInDisabled: t.checkInDisabled,
		scheduleCount: schedules.length,
		timesSet: timesSet,
		activeRounds: t.activeRounds || (schedules.some(s => s.threadId) ? 1 : 0)
	});

	container.textContent = '';
	let doneCount = 0;

	items.forEach(item => {
		if (item.done) doneCount++;
		const stateAttr = item.done ? 'done' : (item.blocked ? 'blocked' : (item.warn ? 'warn' : 'todo'));
		const markIcon = item.done ? '✓' : (item.blocked ? '!' : (item.warn ? '▲' : '○'));

		const itemEl = Dot.Utils.el('div', { class: 'checklist-item', 'data-state': stateAttr },
			Dot.Utils.el('span', { class: 'checklist-mark', text: markIcon }),
			Dot.Utils.el('div', { class: 'checklist-body' },
				Dot.Utils.el('div', { class: 'checklist-title', text: item.label }),
				Dot.Utils.el('div', { class: 'checklist-detail', text: item.detail }),
				item.action ? Dot.Utils.el('a', { class: 'checklist-link', href: item.action, text: 'Go to action →' }) : null
			)
		);
		container.appendChild(itemEl);
	});

	if (badge) {
		badge.textContent = `${doneCount} / ${items.length}`;
		badge.className = `badge badge-${doneCount === items.length ? 'success' : 'secondary'}`;
	}
}

function toggleChecklist() {
	const card = document.getElementById('checklist-container');
	const btn = document.getElementById('btn-toggle-checklist');
	if (!card || !btn) return;
	isChecklistCollapsed = !isChecklistCollapsed;
	card.style.display = isChecklistCollapsed ? 'none' : 'block';
	btn.textContent = isChecklistCollapsed ? 'Expand' : 'Collapse';
}

function getStatusBadgeClass(status) {
	switch (status) {
		case 'preparing': return 'warning';
		case 'in progress': return 'info';
		case 'complete': return 'success';
		default: return 'secondary';
	}
}

function switchTab(tabId) {
	document.querySelectorAll('.tab-btn').forEach(btn => btn.classList.remove('active'));
	document.querySelectorAll('.tab-pane').forEach(pane => pane.classList.remove('active'));
	
	const btn = document.querySelector(`.tab-btn[data-tab="${tabId}"]`);
	const pane = document.getElementById(`pane-${tabId}`);
	
	if (btn && pane) {
		btn.classList.add('active');
		pane.classList.add('active');
		// Update URL hash without jumping
		history.replaceState(null, null, `#${tabId}`);
	}
}

async function syncTournament() {
	try {
		const btn = document.getElementById('btn-sync');
		btn.disabled = true;
		btn.textContent = 'Syncing...';

		const response = await Dot.API.post(`/api/tournaments/${tournamentId}/sync`);
		const data = response.data;

		let message = 'Tournament synced successfully!';
		if (data.matchedPlayers !== undefined) {
			message += ` Matched ${data.matchedPlayers} participants.`;
		}
		if (data.addedSchedules !== undefined) {
			message += ` Added ${data.addedSchedules} new schedules.`;
		}
		if (data.skippedSchedules !== undefined && data.skippedSchedules > 0) {
			message += ` Skipped ${data.skippedSchedules} existing schedules.`;
		}

		Dot.Toast.success(message);

		// Reload data
		await loadTournamentData();
	} catch (error) {
		console.error('Failed to sync tournament:', error);
		Dot.Toast.error('Failed to sync tournament');
	} finally {
		const btn = document.getElementById('btn-sync');
		btn.disabled = false;
		btn.textContent = 'Sync from Challengermode';
	}
}

// Toggle check-in for this tournament
async function toggleCheckIn() {

// Toggle check-in for this tournament
async function toggleCheckIn() {
	const box = document.getElementById('checkin-enabled');
	if (box && box.dataset.ready !== '1') return;
	if (box) box.disabled = true;
	try {
		const result = await Dot.API.post(`/api/tournaments/${tournamentPathId}/toggle-checkin`);
		const disabled = result.checkInDisabled;
		Dot.Toast.success(`Check-in ${disabled ? 'disabled' : 'enabled'} for this tournament.`);
		await loadTournamentData();
	} catch (error) {

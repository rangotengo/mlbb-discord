let editingScheduleId = null;

async function openScheduleModal(schedule = null) {
	editingScheduleId = schedule ? schedule.id : null;

	const title = schedule ? 'Edit Schedule' : 'Add Schedule';
	document.getElementById('schedule-modal-title').textContent = title;

	const manualGroup = document.getElementById('manual-match-group');
	const selectorGroup = document.getElementById('match-selector-group');
	const matchSelect = document.getElementById('schedule-match-select');
	const matchIdInput = document.getElementById('schedule-match-id');
	const teamsContainer = document.getElementById('schedule-teams-container');
	const teamsDisplay = document.getElementById('schedule-teams-display');
	const hint = document.getElementById('match-selector-hint');

	if (schedule) {
		document.getElementById('schedule-id').value = schedule.id;
		matchIdInput.value = schedule.matchId;

		if (schedule.player1Name && schedule.player2Name) {
			teamsDisplay.textContent = `${schedule.player1Name} vs ${schedule.player2Name}`;
			teamsContainer.style.display = 'block';
		} else {
			teamsContainer.style.display = 'none';
		}

		// Convert datetime to datetime-local format
		const date = new Date(schedule.scheduledTime);
		if (!isNaN(date.getTime())) {
			date.setMinutes(date.getMinutes() - date.getTimezoneOffset());
			document.getElementById('schedule-time').value = date.toISOString().slice(0, 16);
		}
		if (schedule.timezone) {
			document.getElementById('schedule-timezone').value = schedule.timezone;
		}
	} else {
		document.getElementById('schedule-form').reset();
		document.getElementById('schedule-id').value = '';
		matchIdInput.value = '';
		teamsContainer.style.display = 'none';
		const defaultTz = document.getElementById('tz-view-select')?.value || currentViewTz;
		if (defaultTz) {
			document.getElementById('schedule-timezone').value = defaultTz;
		}
	}

	manualGroup.style.display = 'none';
	selectorGroup.style.display = 'block';
	matchSelect.innerHTML = '<option value="">Loading matches from Challengermode…</option>';
	matchSelect.disabled = true;

	document.getElementById('schedule-modal').style.display = 'flex';

	try {
		const res = await Dot.API.get(`/api/tournaments/${tournamentId}/matches`);
		currentMatches = res.data || [];
		matchSelect.disabled = false;
		matchSelect.innerHTML = '<option value="">Select a match…</option>';

		currentMatches.forEach(m => {
			const opt = document.createElement('option');
			opt.value = m.matchId;
			opt.textContent = `Round ${m.round}: ${m.player1Name} vs ${m.player2Name} (${m.matchId.slice(0, 8)}…)`;
			if (schedule && schedule.matchId && schedule.matchId.toLowerCase() === m.matchId.toLowerCase()) {
				opt.selected = true;
			}
			matchSelect.appendChild(opt);
		});

		if (hint) hint.textContent = `${currentMatches.length} matches loaded from Challengermode`;

		if (schedule && schedule.matchId) {
			const found = currentMatches.some(m => m.matchId.toLowerCase() === schedule.matchId.toLowerCase());
			if (!found) {
				manualGroup.style.display = 'block';
				selectorGroup.style.display = 'none';
			}
		}
	} catch (err) {
		console.warn('Failed to load matches for selector:', err);
		matchSelect.disabled = false;
		matchSelect.innerHTML = '<option value="">Matches unavailable</option>';
		if (hint) hint.textContent = 'Challengermode unavailable — enter UUID manually';
		manualGroup.style.display = 'block';
		selectorGroup.style.display = 'none';
	}
}

function onMatchSelectDropdownChange() {
	const sel = document.getElementById('schedule-match-select');
	const matchId = sel ? sel.value : '';
	const matchIdInput = document.getElementById('schedule-match-id');
	if (matchIdInput) matchIdInput.value = matchId;

	const selectedMatch = currentMatches.find(m => m.matchId === matchId);
	const teamsContainer = document.getElementById('schedule-teams-container');
	const teamsDisplay = document.getElementById('schedule-teams-display');

	if (selectedMatch && selectedMatch.player1Name && selectedMatch.player2Name) {
		teamsDisplay.textContent = `${selectedMatch.player1Name} vs ${selectedMatch.player2Name}`;
		teamsContainer.style.display = 'block';
		if (!editingScheduleId && selectedMatch.scheduledTime) {
			const d = new Date(selectedMatch.scheduledTime);
			if (!isNaN(d.getTime()) && d.getFullYear() <= 2090) {
				d.setMinutes(d.getMinutes() - d.getTimezoneOffset());
				const timeInput = document.getElementById('schedule-time');
				if (timeInput && !timeInput.value) {
					timeInput.value = d.toISOString().slice(0, 16);
				}
			}
		}
	} else if (!editingScheduleId) {
		teamsContainer.style.display = 'none';
	}
}

function toggleManualMatchInput() {

.checkin-card-heading .info-label { min-width: 0; flex: 1 1 120px; margin-bottom: 0; }
.checkin-card-heading .btn { flex: 0 0 auto; padding: 4px 10px; }
#checkin-channel-value, #t-server { font-size: 16px; text-align: left; overflow-wrap: anywhere; }
.round-announcement.card { padding: 0; margin-bottom: 16px; }
.round-announcement summary { cursor: pointer; padding: 12px 16px; font-size: 16px; line-height: 1.4; font-weight: 600; }
.round-announcement summary:focus-visible { outline: 2px solid var(--text-secondary); outline-offset: 6px; }
.announcement-form { margin: 0; padding: 0 16px 16px; }

.info-grid {
